generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  CANCELED
  FAILED
}

model Customer {
  id           String            @id @default(uuid()) @db.Char(36)
  name         String            @db.VarChar(120)
  email        String            @unique @db.VarChar(191)
  phone        String?           @db.VarChar(30)
  document     String?           @unique @db.VarChar(20)
  passwordHash String?           @db.VarChar(255)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  addresses    CustomerAddress[]
  orders       Order[]
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Char(36)
  label        String?  @db.VarChar(60)
  recipient    String   @db.VarChar(120)
  street       String   @db.VarChar(160)
  number       String   @db.VarChar(30)
  complement   String?  @db.VarChar(120)
  neighborhood String?  @db.VarChar(120)
  city         String   @db.VarChar(120)
  state        String   @db.VarChar(80)
  zipCode      String   @db.VarChar(20)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerId String   @db.Char(36)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Category {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String           @id @default(uuid()) @db.Char(36)
  name             String           @db.VarChar(160)
  slug             String           @unique @db.VarChar(180)
  description      String           @db.Text
  price            Decimal          @db.Decimal(10, 2)
  promotionalPrice Decimal?         @db.Decimal(10, 2)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  categoryId       String?          @db.Char(36)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id         String      @id @default(uuid()) @db.Char(36)
  size       String      @db.VarChar(40)
  color      String      @db.VarChar(80)
  stock      Int         @default(0)
  sku        String      @unique @db.VarChar(80)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  productId  String      @db.Char(36)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Char(36)
  imageUrl  String  @db.VarChar(500)
  alt       String? @db.VarChar(180)
  isMain    Boolean @default(false)
  position  Int     @default(0)
  productId String  @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id            String        @id @default(uuid()) @db.Char(36)
  totalPrice    Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customerId    String?       @db.Char(36)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String          @id @default(uuid()) @db.Char(36)
  quantity  Int
  price     Decimal         @db.Decimal(10, 2)
  orderId   String          @db.Char(36)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String          @db.Char(36)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?         @db.Char(36)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
